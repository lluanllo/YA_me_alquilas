---
import Badge from '../Badge.astro';
import Button from '../ui/Button.astro';
import StatChip from '../ui/StatChip.astro';
const whatsapp = 'https://wa.me/34685710444?text=Hola%20YaMeAlquilas%20%F0%9F%91%8B%20Quiero%20pedir%20presupuesto%20para%20un%20porte%20%2F%20alquiler.';
---
<section id="top" class="relative overflow-hidden bg-ink pt-14 pb-20 sm:pt-20 sm:pb-28">
  <div class="pointer-events-none absolute -right-32 top-1/4 h-[30rem] w-[30rem] rounded-full bg-brand-500/15 blur-3xl"></div>
  <div class="route-line-h pointer-events-none absolute bottom-0 left-0 h-24 w-full opacity-20"></div>
  <div class="relative mx-auto grid min-h-[72vh] max-w-7xl items-center gap-12 px-5 sm:px-8 lg:min-h-[78vh] lg:grid-cols-[0.88fr_1.12fr] lg:gap-10">
    <div class="relative z-10 max-w-xl" data-reveal="left">
      <Badge label="📍 Arganda del Rey, Madrid · Cobertura nacional" tone="dark" />
      <h1 class="mt-7 max-w-[11ch] font-display text-[3.35rem] font-semibold uppercase leading-[0.96] tracking-tight text-white sm:text-6xl md:text-[4.8rem] lg:text-[5.35rem]">
        De Arganda del Rey<br />
        a <span class="text-brand-400">cualquier punto</span><br />
        de España
      </h1>
      <p class="mt-7 max-w-[34rem] font-body text-base leading-relaxed text-white/65 sm:text-lg">
        Transporte profesional de vehículos y alquiler de furgonetas y remolques con bola. Más de 10 años moviendo coches, motos, clásicos y proyectos por toda España.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button label="WhatsApp · Pedir presupuesto" href={whatsapp} icon="chat" variant="whatsapp" size="lg" target="_blank" />
        <Button label="Llamar ahora" href="tel:+34685710444" icon="phone" variant="outlineOnDark" size="lg" />
      </div>
      <div class="mt-10 grid max-w-lg grid-cols-3 gap-4 sm:gap-7">
        <StatChip value="+10" label="Años de experiencia" />
        <StatChip value="2" label="Personas, trato directo" />
        <StatChip value="100%" label="Cobertura nacional" />
      </div>
    </div>

     
    <div class="relative min-w-0 lg:-mr-16" data-reveal="right">
      <div class="absolute -inset-5 rounded-[2.75rem] bg-brand-500/10 blur-2xl"></div>
      <div class="group relative overflow-hidden rounded-[2rem] bg-charcoal shadow-[0_30px_80px_-30px_rgba(0,0,0,0.9)] ring-1 ring-white/10 transition-transform duration-700 hover:scale-[1.015] sm:rounded-[2.75rem]">
        <img src="/seccion_1/imagen_seccion_bienvenida.webp" alt="YaMeAlquilas transporta vehículos y ofrece alquiler de furgonetas y remolques" width="1200" height="800" fetchpriority="high" decoding="async" class="block h-auto w-full object-contain object-center transition-transform duration-1000 group-hover:scale-[1.025]" />
        <div class="pointer-events-none absolute inset-0 bg-black/10"></div>
      </div>
      <!--
      <div class="absolute -bottom-7 left-5 z-10 w-[min(19rem,calc(100%-2.5rem))] rounded-2xl bg-white p-4 shadow-card ring-1 ring-ink/10 transition-transform duration-500 hover:-translate-y-1 sm:-left-8 sm:bottom-8 sm:p-5" data-reveal="scale">
        <p class="font-mono text-[10px] font-bold uppercase tracking-widest text-brand-600">Tu porte, paso a paso</p>
        <div class="mt-3 flex items-center gap-2">
          <span class="h-2 w-2 shrink-0 rounded-full bg-brand-500"></span>
          <span class="text-xs font-semibold text-ink/80">Recogida · Arganda del Rey</span>
        </div>
        <div class="my-1 ml-[3px] h-3 w-px route-line"></div>
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 shrink-0 rounded-full bg-ink/20"></span>
          <span class="text-xs font-semibold text-ink/60">Entrega · Tu destino</span>
        </div>
        <p class="mt-3 text-[10px] leading-relaxed text-ink/45">Te avisamos por WhatsApp durante el trayecto.</p>
      </div>-->
    </div>
  </div>
</section>
