---
import SectionEyebrow from './SectionEyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  tone?: 'light' | 'dark';
  align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, tone = 'light', align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  <SectionEyebrow label={eyebrow} tone={tone} />
  <h2 class:list={[
    'font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] font-semibold uppercase tracking-tight',
    tone === 'dark' ? 'text-white' : 'text-ink',
  ]}>{title}</h2>
  {subtitle && <p class:list={['mt-4 text-base sm:text-lg font-body leading-relaxed', tone === 'dark' ? 'text-white/65' : 'text-slate/70']}>{subtitle}</p>}
</div>
