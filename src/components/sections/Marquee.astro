---
import Icon from '../ui/Icon.astro';
const items = ['Transporte personalizado', 'Cercano y de confianza', 'Te mantenemos informados', 'Entrega siempre el mismo día', 'Remolques, vehículos con bola y portes', 'Déjanos hacer tu porte, valóranos tú mism@'];
---
<section class="select-none overflow-hidden bg-brand-700 py-4" aria-label="Lemas de la empresa"><div class="marquee-track">{[...items, ...items].map((text) => <span class="flex items-center gap-4 px-4 sm:gap-6 sm:px-6"><span class="font-display text-sm uppercase tracking-wide text-white/90 sm:text-base">{text}</span><Icon name="spark" class="h-4 w-4 text-brand-500" /></span>)}</div></section>
