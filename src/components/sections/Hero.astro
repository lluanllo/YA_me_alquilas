---
import Badge from '../Badge.astro';
import Button from '../ui/Button.astro';
import StatChip from '../ui/StatChip.astro';
const whatsapp = 'https://wa.me/34685710444?text=Hola%20YaMeAlquilas%20%F0%9F%91%8B%20Quiero%20pedir%20presupuesto%20para%20un%20porte%20%2F%20alquiler.';
---
<section id="top" class="relative overflow-hidden bg-ink pt-14 pb-20 sm:pt-20 sm:pb-28">
  <div class="pointer-events-none absolute -top-40 -right-40 h-[36rem] w-[36rem] rounded-full bg-brand-500/20 blur-3xl"></div>
  <div class="route-line-h pointer-events-none absolute bottom-0 left-0 h-40 w-full opacity-20"></div>
  <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-2">
    <div data-reveal>
      <Badge label="📍 Arganda del Rey, Madrid · Cobertura nacional" tone="dark" />
      <h1 class="mt-6 font-display text-4xl font-semibold uppercase leading-[1.02] tracking-tight text-white sm:text-5xl md:text-[3.4rem]">
        De Arganda del Rey a 
        <span class="text-brand-400">
          cualquier punto
        </span>
          de España
      </h1>
      <p class="mt-6 max-w-lg font-body text-base leading-relaxed text-white/65 sm:text-lg">
        Transporte profesional de vehículos y alquiler de furgonetas y remolques con bola. Más de 10 años moviendo coches, motos, clásicos y proyectos por toda España — trato directo, sin intermediarios.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button label="Pedir presupuesto por WhatsApp" href={whatsapp} icon="chat" variant="whatsapp" size="lg" target="_blank" />
          <Button label="Llamar ahora" href="tel:+34685710444" icon="phone" variant="outlineOnDark" size="lg" />
        </div>
        <div class="mt-12 grid max-w-md grid-cols-3 gap-6">
          <StatChip value="+10" label="Años de experiencia" />
          <StatChip value="2" label="Personas, trato directo" />
          <StatChip value="100%" label="España, mismo día" />
        </div>
      </div>
    <div class="relative" data-reveal>
      <div class="relative rounded-5xl bg-charcoal p-6 shadow-glow ring-1 ring-white/10 sm:p-10">
        <img src="/seccion_1/imagen_seccion_bienvenida.webp" alt="YaMeAlquilas transporta vehículos y ofrece alquiler de furgonetas y remolques" width="1200" height="800" fetchpriority="high" decoding="async" class="mx-auto w-full max-w-sm rounded-4xl" />
      </div>
      <div class="absolute -bottom-8 -left-8 hidden w-64 rounded-3xl bg-white p-5 shadow-card sm:block" data-reveal>
        <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-brand-600">Tu porte, paso a paso</p>
        <div class="mt-3 flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-brand-500"></span>
          <span class="text-xs font-semibold text-ink/80">Recogida · Arganda del Rey</span>
        </div>
        <div class="my-1 ml-[4px] h-4 w-px route-line"></div>
        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-ink/20"></span>
          <span class="text-xs font-semibold text-ink/60">Entrega · tu destino</span>
        </div>
        <p class="mt-3 text-[11px] leading-relaxed text-ink/45">Te avisamos por WhatsApp en cada paso del trayecto.</p>
      </div>
    </div>
  </div>
</section>
