---
interface Props { initials: string; tone?: 'brand' | 'ink' }
const { initials, tone = 'brand' } = Astro.props;
---
<span class:list={['inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl font-display text-lg font-semibold', tone === 'brand' ? 'bg-brand-500 text-white' : 'bg-ink text-brand-400']}>{initials}</span>
