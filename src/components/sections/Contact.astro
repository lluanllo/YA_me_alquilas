---
import Button from '../ui/Button.astro';
import ContactCard from '../ContactCard.astro';
import QuickQuote from '../QuickQuote.astro';
import SectionHeading from '../ui/SectionHeading.astro';
const whatsapp = 'https://wa.me/34685710444?text=Hola%20YaMeAlquilas%20%F0%9F%91%8B%20Quiero%20pedir%20presupuesto.';
---
<section id="contacto" class="bg-mist py-20 sm:py-28"><div class="mx-auto max-w-7xl px-5 sm:px-8"><SectionHeading eyebrow="Contacto" title="Pide presupuesto o resuelve tus dudas en minutos" subtitle="Sin centralitas ni esperas: hablas directamente con quien va a llevar tu vehículo." align="center" /><div class="mt-14 grid items-start gap-6 lg:grid-cols-2"><QuickQuote /><div class="overflow-hidden rounded-4xl bg-white ring-1 ring-ink/[0.06]" data-reveal><iframe src="https://www.google.com/maps?q=Arganda+del+Rey,+Madrid,+Espa%C3%B1a&output=embed" class="h-64 w-full grayscale-[35%] sm:h-72" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Ubicación de YaMeAlquilas.com — Arganda del Rey, Madrid"></iframe><div class="flex items-center justify-between gap-4 p-6"><div><p class="font-display text-base font-semibold uppercase tracking-tight text-ink">Arganda del Rey, Madrid</p><p class="text-sm text-slate/60">Salimos desde aquí a cualquier punto de España</p></div><Button label="Cómo llegar" href="https://www.google.com/maps/dir/?api=1&destination=Arganda+del+Rey,+Madrid" icon="pin" variant="outline" size="sm" target="_blank" /></div></div></div><div class="mt-6 grid gap-5 sm:grid-cols-3"><ContactCard icon="chat" title="WhatsApp" value="685 710 444" desc="Respuesta rápida — manda fotos y ubicación del vehículo." href={whatsapp} cta="Escribir por WhatsApp" variant="whatsapp" target="_blank" /><ContactCard icon="phone" title="Llamada" value="685 710 444" desc="Te atendemos personalmente, sin centralitas." href="tel:+34685710444" cta="Llamar ahora" variant="dark" /><ContactCard icon="camera" title="Instagram" value="@yamealquilascom" desc="Sigue nuestros portes y alquileres del día a día." href="https://www.instagram.com/yamealquilascom" cta="Ver Instagram" target="_blank" /></div></div></section>
