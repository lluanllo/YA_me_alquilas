---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'YaMeAlquilas.com — Transporte de vehículos y alquiler de furgonetas y remolques',
  description = 'Transporte profesional de vehículos y alquiler de furgonetas y remolques con bola en Arganda del Rey, Madrid. Cobertura en toda España.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta name="theme-color" content="#0B0D10" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="antialiased">
    <slot />
  </body>
</html>