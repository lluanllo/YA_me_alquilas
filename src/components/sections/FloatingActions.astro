---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site, whatsappLink } from '../../data/site';
const whatsapp = whatsappLink('Hola YaMeAlquilas 👋 Quiero pedir presupuesto.');
---
<><a href={whatsapp} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp" class="fixed bottom-6 right-5 z-50 hidden h-14 w-14 items-center justify-center rounded-full bg-wa text-white shadow-[0_15px_35px_-10px_rgba(37,211,102,0.6)] transition-transform hover:scale-105 sm:flex"><Icon name="chat" class="h-6 w-6" /></a><div class="fixed bottom-0 left-0 z-40 flex w-full gap-3 border-t border-ink/[0.08] bg-white px-4 py-3 md:hidden"><Button label="Llamar" href={site.phone.tel} icon="phone" variant="dark" full size="sm" /><Button label="WhatsApp" href={whatsapp} icon="chat" variant="whatsapp" full size="sm" target="_blank" /></div></>
