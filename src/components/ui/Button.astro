---
import Icon from './Icon.astro';
import type { IconName } from '../../types';

interface Props {
  label: string;
  href?: string;
  icon?: IconName;
  variant?: 'primary' | 'dark' | 'outline' | 'outlineOnDark' | 'whatsapp' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  full?: boolean;
  target?: string;
}

const {
  label,
  href = '#',
  icon,
  variant = 'primary',
  size = 'md',
  full = false,
  target,
} = Astro.props;

const sizes = { sm: 'px-4 py-2 text-sm', md: 'px-5 py-3 text-[15px]', lg: 'px-7 py-4 text-base' };
const variants = {
  primary: 'bg-brand-500 text-white hover:bg-brand-600 shadow-glow',
  dark: 'bg-ink text-white hover:bg-slate',
  outline: 'bg-transparent text-ink ring-2 ring-ink/15 hover:ring-ink/40',
  outlineOnDark: 'bg-transparent text-white ring-2 ring-white/25 hover:ring-white/60',
  whatsapp: 'bg-wa text-white hover:brightness-95 shadow-[0_15px_35px_-12px_rgba(37,211,102,0.55)]',
  ghost: 'bg-white/10 text-white hover:bg-white/20',
};
---

<a
  href={href}
  target={target}
  rel={target ? 'noopener' : undefined}
  class:list={[
    'group inline-flex items-center justify-center gap-2 rounded-full font-body font-bold tracking-tight transition-all duration-200',
    sizes[size],
    variants[variant],
    full && 'w-full',
  ]}
>
  {icon && <Icon name={icon} class="h-4 w-4" />}
  <span>{label}</span>
</a>
