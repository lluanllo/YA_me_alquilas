---
import Badge from '../Badge.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceCard from '../ServiceCard.astro';
import PriceCard from '../PriceCard.astro';
const rentalCards = [{ icon: 'van', title: 'Alquiler de furgonetas', desc: 'Furgonetas listas para tu mudanza, evento o carga, por días o fines de semana.' }, { icon: 'trailer', title: 'Remolques para coches', desc: 'Remolques homologados para transportar tu propio vehículo con total seguridad.' }, { icon: 'bike', title: 'Remolques para motos', desc: 'Remolques específicos para una o varias motos, fáciles de enganchar y remolcar.' }, { icon: 'truckcheck', title: 'Vehículos con bola de remolque', desc: 'Turismos preparados con bola, listos para enganchar en el momento que los necesites.' }] as const;
const transportCards = [{ icon: 'car', title: 'Coches y compraventas', desc: 'Portes para particulares y compraventas entre concesionarios, con entrega el mismo día.' }, { icon: 'star', title: 'Clásicos y competición', desc: 'Manipulación cuidadosa para clásicos, coches de carreras y piezas de coleccionista.' }, { icon: 'bike', title: 'Motos y caravanas', desc: 'Transporte seguro de motos y caravanas, ancladas y protegidas durante todo el trayecto.' }, { icon: 'route', title: 'Food trucks y maquinaria', desc: 'Trasladamos food trucks, mobiliario de eventos y maquinaria a cualquier punto del país.' }] as const;
---
<section id="servicios" class="bg-white py-20 sm:py-28"><div class="mx-auto max-w-7xl px-5 sm:px-8"><SectionHeading eyebrow="Servicios" title="Dos formas de moverte, un único equipo de confianza" subtitle="Elige la opción que mejor encaja contigo: conduces tú con nuestro material, o nos encargamos nosotros de todo el trayecto." align="center" /><div class="mt-16"><div class="mb-8 flex items-center justify-center gap-3"><Badge label="Tú conduces" /><h3 class="font-display text-2xl font-semibold uppercase tracking-tight text-ink sm:text-3xl">Alquiler de furgonetas y remolques</h3></div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{rentalCards.map((card) => <ServiceCard {...card} />)}</div></div><div class="mt-20"><div class="mb-8 flex items-center justify-center gap-3"><Badge label="Nosotros lo llevamos" /><h3 class="font-display text-2xl font-semibold uppercase tracking-tight text-ink sm:text-3xl">Transporte de vehículos</h3></div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{transportCards.map((card) => <ServiceCard {...card} />)}</div></div><div class="mx-auto mt-16 grid max-w-3xl gap-4 sm:grid-cols-2"><PriceCard zone="Provincia de Madrid" price="Desde 50 €" note="Portes dentro de la provincia" /><PriceCard zone="Fuera de Madrid" price="Desde 100 €" note="Cobertura en toda España" /></div><p class="mx-auto mt-4 max-w-md text-center text-sm text-slate/60">Presupuesto ajustado a tu porte — sin sorpresas. Escríbenos y te lo confirmamos en minutos.</p><div class="mt-6 flex justify-center"><Button label="Pide tu presupuesto" href="https://wa.me/34685710444?text=Hola%20YaMeAlquilas%20%F0%9F%91%8B%20Quiero%20pedir%20presupuesto." icon="chat" target="_blank" /></div></div></section>
