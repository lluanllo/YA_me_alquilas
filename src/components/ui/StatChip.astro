---
interface Props { value: string; label: string }
const { value, label } = Astro.props;
---
<div class="flex flex-col gap-0.5 border-l-2 border-brand-500/60 pl-3">
  <span class="font-mono text-lg sm:text-xl font-bold text-white">{value}</span>
  <span class="text-[11px] sm:text-xs uppercase tracking-wider text-white/60 font-body">{label}</span>
</div>
