---
import Badge from './Badge.astro';
import Avatar from './ui/Avatar.astro';
interface Props { initials: string; name: string; role: string; desc: string; badge?: string }
const { initials, name, role, desc, badge } = Astro.props;
---
<div class="flex flex-col gap-4 rounded-4xl bg-white p-7 ring-1 ring-ink/[0.06]" data-reveal><div class="flex items-center justify-between"><Avatar initials={initials} />{badge && <Badge label={badge} />}</div><div><h4 class="font-display text-xl font-semibold uppercase tracking-tight text-ink">{name}</h4><p class="mt-1 font-mono text-xs uppercase tracking-wider text-brand-600">{role}</p></div><p class="text-sm leading-relaxed text-slate/70">{desc}</p></div>
